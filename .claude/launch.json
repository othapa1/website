{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Static site (Python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4000"],
      "port": 4000
    },
    {
      "name": "Static site (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3001", "--no-clipboard"],
      "port": 3001
    }
  ]
}
